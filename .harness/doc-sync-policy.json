{
  "version": 1,
  "rules": [
    {
      "id": "desktop-contract",
      "sources": [
        "src-tauri/src/main.rs",
        "src-tauri/src/lib.rs",
        "src-tauri/src/*.rs",
        "src-tauri/src/**/*.rs",
        "src-tauri/src/commands/**/*.rs",
        "src/lib/local-store.ts",
        "src/lib/agent-tools.ts"
      ],
      "requiredDocs": [
        "docs/architecture.md",
        "docs/api.md",
        "TASKS.md"
      ]
    },
    {
      "id": "provider-security",
      "sources": [
        "src-tauri/src/oauth.rs",
        "src-tauri/src/custom_api.rs",
        "src-tauri/src/music_provider.rs",
        "src-tauri/src/provider.rs",
        "src-tauri/src/agent.rs"
      ],
      "requiredDocs": [
        "AGENTS.md",
        "docs/decisions.md"
      ]
    },
    {
      "id": "desktop-runtime",
      "sources": [
        "package.json",
        "src-tauri/Cargo.toml",
        "src-tauri/tauri.conf.json"
      ],
      "requiredDocs": [
        "README.md",
        "docs/architecture.md",
        "docs/decisions.md",
        "TASKS.md"
      ]
    },
    {
      "id": "architecture-guardrails",
      "sources": [
        ".harness/architecture-budgets.json",
        "scripts/check-architecture-budgets.mjs",
        "scripts/test-architecture-budgets.mjs"
      ],
      "requiredDocs": [
        "docs/architecture.md",
        "docs/decisions.md",
        "docs/harness.md",
        "TASKS.md"
      ]
    },
    {
      "id": "agent-context-guardrails",
      "sources": [
        ".harness/agent-context.json",
        ".harness/branch-policy.json",
        ".githooks/pre-commit",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "CLAUDE.md",
        ".cursor/rules/project-workflow.mdc",
        "opencode.json",
        ".github/pull_request_template.md",
        "src/AGENTS.md",
        "src-tauri/src/AGENTS.md",
        "scripts/check-agent-contracts.mjs",
        "scripts/test-agent-contracts.mjs",
        "scripts/check-branch-policy.mjs",
        "scripts/test-branch-policy.mjs"
      ],
      "requiredDocs": [
        "AGENTS.md",
        "README.md",
        "docs/architecture.md",
        "docs/decisions.md",
        "docs/harness.md",
        "TASKS.md"
      ]
    }
  ],
  "changeRecordDirectory": "docs/changes"
}
