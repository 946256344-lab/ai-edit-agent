{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Assembly Video Agent",
  "version": "0.1.1",
  "identifier": "com.assembly.videoagent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Assembly Video Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://localhost:5173 ws://localhost:5173",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "scripts/create_jianying_draft.py",
      "resources/models/bge-small-zh-v1.5/config.json",
      "resources/models/bge-small-zh-v1.5/special_tokens_map.json",
      "resources/models/bge-small-zh-v1.5/tokenizer_config.json",
      "resources/models/bge-small-zh-v1.5/tokenizer.json",
      "resources/models/bge-small-zh-v1.5/onnx/model.onnx",
      "resources/models/bge-small-zh-v1.5/LICENSE",
      "resources/models/bge-small-zh-v1.5/NOTICE.md",
      "resources/models/clip-ViT-B-32-vision/config.json",
      "resources/models/clip-ViT-B-32-vision/preprocessor_config.json",
      "resources/models/clip-ViT-B-32-vision/model.onnx",
      "resources/models/clip-ViT-B-32-vision/NOTICE.md",
      "resources/models/clip-ViT-B-32-text/config.json",
      "resources/models/clip-ViT-B-32-text/tokenizer.json",
      "resources/models/clip-ViT-B-32-text/tokenizer_config.json",
      "resources/models/clip-ViT-B-32-text/special_tokens_map.json",
      "resources/models/clip-ViT-B-32-text/model.onnx",
      "resources/models/clip-ViT-B-32-text/NOTICE.md"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
